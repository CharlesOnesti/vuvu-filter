{
  "manifest_version": 3,
  "name": "Honk Filter (All Sites) — stadium horn suppressor",
  "version": "2.0.0",
  "description": "Suppresses air-horn / vuvuzela tonal noise on any Chrome video tab (YouTube, Fubo, Fox Sports, Tennis Channel, etc.) while keeping announcers and crowd atmosphere.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabCapture",
    "offscreen"
  ],
  "optional_host_permissions": ["*://*/*", "file:///*"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Honk Filter — click while a stream is playing",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/worklet/dehonk-processor.js",
        "src/common/*.js",
        "test/bench.html",
        "*.ogg"
      ],
      "matches": ["*://*/*", "file:///*"]
    }
  ]
}
